ARG BASE_IMAGE=world/wheeledlab:isaac6.0.1-experimental
FROM ${BASE_IMAGE}
LABEL org.world.benchmark="omniisaacgymenvs" org.world.runtime="Isaac6.0.1 experimental compatibility"
RUN python -m pip install --no-cache-dir hydra-core==1.3.2 gym==0.26.2
ENV ACCEPT_EULA=Y OMNI_KIT_ACCEPT_EULA=YES PYTHONDONTWRITEBYTECODE=1
WORKDIR /world
