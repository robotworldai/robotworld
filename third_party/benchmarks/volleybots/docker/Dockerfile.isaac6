FROM world/omnidrones:isaac6.0.1-experimental
LABEL org.world.benchmark="VolleyBots" org.world.runtime="Isaac6.0.1 experimental; not official physics equivalence"
ENV MAX_JOBS=4 PYTHONDONTWRITEBYTECODE=1
COPY checkout/third_party/tensordict /opt/volley-tensordict
COPY checkout/third_party/rl /opt/volley-torchrl
RUN python -m pip install --no-cache-dir --no-deps --no-build-isolation /opt/volley-tensordict /opt/volley-torchrl
RUN python -m pip install --no-cache-dir filterpy setproctitle
WORKDIR /world
